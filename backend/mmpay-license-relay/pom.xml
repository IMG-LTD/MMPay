<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.imgltd.mmpay</groupId>
    <artifactId>mmpay-backend</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>mmpay-license-relay</artifactId>
  <name>MMPay License Relay</name>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Spec §1.1.3 layered defense layer 2: maven-enforcer-plugin bannedDependencies. The relay
        module's allowed transitive graph is intentionally tight: java.net.http / java.nio /
        java.security / slf4j-api only. Anything that pulls Jackson, SnakeYAML, protobuf, Reactor,
        Coroutines, Netty, OkHttp, Apache HC, Spring AOP, AspectJ, or any other shared HTTP/
        deserialization module fails the build before tests run.
      -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>license-relay-banned-deps</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.fasterxml.jackson.core:*</exclude>
                    <exclude>com.fasterxml.jackson.databind:*</exclude>
                    <exclude>com.fasterxml.jackson.dataformat:*</exclude>
                    <exclude>org.yaml:snakeyaml</exclude>
                    <exclude>com.google.protobuf:*</exclude>
                    <exclude>org.jetbrains.kotlinx:kotlinx-serialization-core</exclude>
                    <exclude>org.jetbrains.kotlinx:kotlinx-coroutines-core</exclude>
                    <exclude>com.squareup.moshi:*</exclude>
                    <exclude>com.google.code.gson:gson</exclude>
                    <exclude>io.projectreactor:reactor-core</exclude>
                    <exclude>io.netty:*</exclude>
                    <exclude>com.squareup.okhttp3:*</exclude>
                    <exclude>org.apache.httpcomponents:*</exclude>
                    <exclude>org.apache.httpcomponents.client5:*</exclude>
                    <exclude>org.apache.httpcomponents.core5:*</exclude>
                    <exclude>org.springframework:spring-aop</exclude>
                    <exclude>org.springframework:spring-web</exclude>
                    <exclude>org.springframework:spring-webmvc</exclude>
                    <exclude>org.aspectj:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
